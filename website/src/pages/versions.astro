---
import Layout from "../layouts/Layout.astro";
import { u, site, versionLinks } from "../data/site";
import { releases } from "../data/versions";
const btn = "display:inline-flex;align-items:center;height:44px;padding:0 16px;border-radius:8px;font-weight:600;font-size:15px";
---
<Layout
  title="Earlier versions of DriftFetch – download older builds"
  description="Need an older build of DriftFetch? Every released version for Windows is listed here with its installer and portable download."
  path="/versions"
  current="/download"
  jsonld={[]}
>
  <section data-tide="1" style="background:#010930;color:#f2f5ff;padding:clamp(56px,8vw,104px) clamp(20px,4vw,48px) 120px">
    <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
      <h1 style="margin:0;font-size:clamp(42px,6vw,84px);line-height:1;font-weight:700;letter-spacing:-0.04em;max-width:13ch;text-wrap:balance">Earlier versions.</h1>
      <p style="margin:28px 0 0;max-width:32em;font-size:clamp(18px,1.6vw,20px);color:#c7cfea;text-wrap:pretty">Every released build of DriftFetch for Windows, newest first. Unless something is broken for you, the latest one is the best choice.</p>
      <p style="margin:24px 0 0"><a href={u("/download")} style="color:#f2f5ff;font-weight:500;border-bottom:1px solid rgba(242,245,255,0.35);padding-bottom:2px">Back to the latest download</a></p>
    </div>
  </section>
  <section data-tide="1" style="background:#fff;padding:110px clamp(20px,4vw,48px)">
    <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto;display:flex;flex-direction:column">
      {releases.map((r, i) => {
        const l = versionLinks(r.version);
        return (
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:20px 48px;padding:28px 0;border-top:1px solid rgba(1,9,48,0.14)">
            <div>
              <h2 style="margin:0;font-size:clamp(26px,3vw,34px);font-weight:800;letter-spacing:-0.03em">Version {r.version}{r.version === site.version && <span style="margin-left:10px;font-size:14px;font-weight:600;color:#0a55d6;letter-spacing:0">Latest</span>}</h2>
              {r.date && <p style="margin:4px 0 0;color:#596180">{r.date}</p>}
              <ul style="margin:12px 0 0;padding-left:20px;color:#353d5c">{r.notes.map((n) => <li>{n}</li>)}</ul>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:12px;align-content:start">
              <a href={l.installer} style={btn + ";background:#0b67fe;color:#fff"}>Installer (.exe)</a>
              <a href={l.portable} style={btn + ";background:#e4e9f4;color:#010930"}>Portable</a>
            </div>
          </div>
        );
      })}
      <p style="margin:32px 0 0;color:#596180;font-size:15px;max-width:40em">Older builds don't get fixes. Sites change often, so an old version may stop working on some of them.</p>
    </div>
  </section>
</Layout>
