---
import Layout from "../layouts/Layout.astro";
import { u, site, links } from "../data/site";
---
<Layout
  title="Privacy – DriftFetch"
  description="DriftFetch has no account, no ads and no tracking. Here is exactly what stays on your PC and what leaves it."
  path="/privacy"
  current="/privacy"
  jsonld={[]}
>

    <section data-tide="1" style="background:#010930;color:#f2f5ff;padding:clamp(56px,8vw,104px) clamp(20px,4vw,48px) 120px">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
        <h1 style="margin:0;font-size:clamp(42px,6vw,84px);line-height:1;font-weight:700;letter-spacing:-0.04em;max-width:13ch;text-wrap:balance">Your downloads are your business.</h1>
        <p style="margin:28px 0 0;max-width:32em;font-size:clamp(18px,1.6vw,20px);color:#c7cfea;text-wrap:pretty">No account, no ads, no tracking, not even on this website. Here’s exactly what stays on your PC and what leaves it, in plain words.</p>
      </div>
    </section>
    <section data-tide="1" style="background:#fff;padding:110px clamp(20px,4vw,48px)">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:40px 72px">
          <h2 style="margin:0;font-size:clamp(32px,4vw,52px);line-height:1.02;font-weight:800;letter-spacing:-0.04em;text-wrap:balance">Stays on your PC</h2>
          <div style="display:flex;flex-direction:column"><div style="display:flex;gap:18px;padding:22px 0 24px;border-top:1px solid rgba(1,9,48,0.14)"><span style="flex:none;width:40px;height:40px;border-radius:10px;background:#010930;color:#0cf3fe;display:flex;align-items:center;justify-content:center"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915" />
  <circle cx="12" cy="12" r="3" /></svg></span></span><div><h3 style="margin:0 0 4px;font-size:20px;font-weight:700;letter-spacing:-0.015em">Your settings and history</h3><p style="margin:0;color:#353d5c;text-wrap:pretty">Everything you’ve downloaded and how you like things set up.</p></div></div><div style="display:flex;gap:18px;padding:22px 0 24px;border-top:1px solid rgba(1,9,48,0.14)"><span style="flex:none;width:40px;height:40px;border-radius:10px;background:#010930;color:#0cf3fe;display:flex;align-items:center;justify-content:center"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z" />
  <circle cx="16.5" cy="7.5" r=".5" fill="currentColor" /></svg></span></span><div><h3 style="margin:0 0 4px;font-size:20px;font-weight:700;letter-spacing:-0.015em">Site sign-ins</h3><p style="margin:0;color:#353d5c;text-wrap:pretty">Encrypted with your Windows account, so only you can read them on this PC.</p></div></div><div style="display:flex;gap:18px;padding:22px 0 24px;border-top:1px solid rgba(1,9,48,0.14)"><span style="flex:none;width:40px;height:40px;border-radius:10px;background:#010930;color:#0cf3fe;display:flex;align-items:center;justify-content:center"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 11v6" />
  <path d="M14 11v6" />
  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
  <path d="M3 6h18" />
  <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg></span></span><div><h3 style="margin:0 0 4px;font-size:20px;font-weight:700;letter-spacing:-0.015em">All in one folder</h3><p style="margin:0;color:#353d5c;text-wrap:pretty">Settings › Advanced shows where it is. Delete it and DriftFetch forgets everything.</p></div></div></div>
        </div>
      </div>
    </section>
    <section data-tide="1" style="background:#e4e9f4;padding:110px clamp(20px,4vw,48px)">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:40px 72px">
          <h2 style="margin:0;font-size:clamp(32px,4vw,52px);line-height:1.02;font-weight:800;letter-spacing:-0.04em;text-wrap:balance">Leaves your PC</h2>
          <div style="display:flex;flex-direction:column"><div style="display:flex;gap:18px;padding:22px 0 24px;border-top:1px solid rgba(1,9,48,0.14)"><span style="flex:none;width:40px;height:40px;border-radius:10px;background:#010930;color:#0cf3fe;display:flex;align-items:center;justify-content:center"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" />
  <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
  <path d="M2 12h20" /></svg></span></span><div><h3 style="margin:0 0 4px;font-size:20px;font-weight:700;letter-spacing:-0.015em">Requests to the sites you download from</h3><p style="margin:0;color:#353d5c;text-wrap:pretty">The same requests your browser would make when you watch the video.</p></div></div><div style="display:flex;gap:18px;padding:22px 0 24px;border-top:1px solid rgba(1,9,48,0.14)"><span style="flex:none;width:40px;height:40px;border-radius:10px;background:#010930;color:#0cf3fe;display:flex;align-items:center;justify-content:center"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg></span></span><div><h3 style="margin:0 0 4px;font-size:20px;font-weight:700;letter-spacing:-0.015em">A check with GitHub for engine updates</h3><p style="margin:0;color:#353d5c;text-wrap:pretty">Updates are verified against the maintainers’ signatures before they install. You can turn this off.</p></div></div><div style="display:flex;gap:18px;padding:22px 0 24px;border-top:1px solid rgba(1,9,48,0.14)"><span style="flex:none;width:40px;height:40px;border-radius:10px;background:#010930;color:#0cf3fe;display:flex;align-items:center;justify-content:center"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" />
  <path d="M4.929 4.929 19.07 19.071" /></svg></span></span><div><h3 style="margin:0 0 4px;font-size:20px;font-weight:700;letter-spacing:-0.015em">Nothing to us</h3><p style="margin:0;color:#353d5c;text-wrap:pretty">There’s no DriftFetch server and no analytics. We couldn’t see your downloads if we wanted to.</p></div></div></div>
        </div>
      </div>
    </section>
    <section data-tide="1" style="background:#010930;color:#f2f5ff;padding:110px clamp(20px,4vw,48px)">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:40px 72px">
          <h2 style="margin:0;font-size:clamp(32px,4vw,52px);line-height:1.02;font-weight:800;letter-spacing:-0.04em;text-wrap:balance">This website</h2>
          <div style="display:flex;flex-direction:column"><div style="display:flex;gap:18px;padding:22px 0 24px;border-top:1px solid rgba(255,255,255,0.16)"><span style="flex:none;width:40px;height:40px;border-radius:10px;background:rgba(12,243,254,0.12);color:#0cf3fe;display:flex;align-items:center;justify-content:center"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 17h.01" />
  <path d="M11.496 2c.324-.016.558.292.529.615a4 4 0 004.235 4.368.713.713 0 01.758.757 4 4 0 004.366 4.237c.323-.03.63.204.614.527a10 10 0 01-2.915 6.566A1 1 0 114.93 4.918 10 10 0 0111.496 2" />
  <path d="M12 12h.01" />
  <path d="M16 16h.01" />
  <path d="M16 3h.01" />
  <path d="M21 4h.01" />
  <path d="M21 8h.01" />
  <path d="M7 14h.01" />
  <path d="M9 8h.01" /></svg></span></span><div><h3 style="margin:0 0 4px;font-size:20px;font-weight:700;letter-spacing:-0.015em">No cookies</h3><p style="margin:0;color:#c7cfea;text-wrap:pretty">So there’s no cookie banner to click away.</p></div></div><div style="display:flex;gap:18px;padding:22px 0 24px;border-top:1px solid rgba(255,255,255,0.16)"><span style="flex:none;width:40px;height:40px;border-radius:10px;background:rgba(12,243,254,0.12);color:#0cf3fe;display:flex;align-items:center;justify-content:center"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 21v-6" />
  <path d="M12 21V3" />
  <path d="M19 21V9" /></svg></span></span><div><h3 style="margin:0 0 4px;font-size:20px;font-weight:700;letter-spacing:-0.015em">No analytics</h3><p style="margin:0;color:#c7cfea;text-wrap:pretty">No visitor counting, no fingerprinting, no third-party scripts.</p></div></div><div style="display:flex;gap:18px;padding:22px 0 24px;border-top:1px solid rgba(255,255,255,0.16)"><span style="flex:none;width:40px;height:40px;border-radius:10px;background:rgba(12,243,254,0.12);color:#0cf3fe;display:flex;align-items:center;justify-content:center"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v16" />
  <path d="M4 7V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2" />
  <path d="M9 20h6" /></svg></span></span><div><h3 style="margin:0 0 4px;font-size:20px;font-weight:700;letter-spacing:-0.015em">Self-hosted fonts</h3><p style="margin:0;color:#c7cfea;text-wrap:pretty">Fonts load from this site, not from a font service.</p></div></div></div>
        </div>
        <p style="margin:56px 0 0;color:#8a96bd">The full, formal version is in the <a href={u("/legal#privacy")} style="color:#5fe3ee" class="hxpj8jr">privacy policy</a>.</p>
      </div>
    </section>
  

</Layout>
