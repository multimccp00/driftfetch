---
import Layout from "../layouts/Layout.astro";
import { u, site, links } from "../data/site";
---
<Layout
  title="FAQ – DriftFetch"
  description="Answers about DriftFetch: where files go, playlists, quality, rate limits, sign-ins, privacy and safety."
  path="/faq"
  current="/faq"
  jsonld={[{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is DriftFetch really free?","acceptedAnswer":{"@type":"Answer","text":"Yes. It’s MIT-licensed open source with no ads, trials or paid features."}},{"@type":"Question","name":"Do I need an account?","acceptedAnswer":{"@type":"Answer","text":"No. There’s nothing to sign up for."}},{"@type":"Question","name":"Mac or Linux?","acceptedAnswer":{"@type":"Answer","text":"Not yet. DriftFetch is built and tested for Windows 10 and 11 only."}},{"@type":"Question","name":"Which sites does it work with?","acceptedAnswer":{"@type":"Answer","text":"Sites supported by yt-dlp and gallery-dl, such as YouTube, Reddit, Vimeo and Internet Archive. See the supported sites page."}},{"@type":"Question","name":"Where do my files go?","acceptedAnswer":{"@type":"Answer","text":"To Downloads\\DriftFetch by default, in a folder per site. You can change the folder, sorting and file names in Settings."}},{"@type":"Question","name":"How do I download a playlist or album?","acceptedAnswer":{"@type":"Answer","text":"Copy its link. DriftFetch shows every item with a thumbnail and you tick what you want."}},{"@type":"Question","name":"Can I pick the quality?","acceptedAnswer":{"@type":"Answer","text":"By default it takes the best quality available. You can set a maximum resolution or a preferred format in Settings."}},{"@type":"Question","name":"Will it download the same thing twice?","acceptedAnswer":{"@type":"Answer","text":"No. Links you’ve already saved are caught and marked “Already in list”."}},{"@type":"Question","name":"It says “Rate limited”. Is that an error?","acceptedAnswer":{"@type":"Answer","text":"No. The site asked DriftFetch to slow down. It waits as long as it was told to and carries on by itself."}},{"@type":"Question","name":"It says “Sign-in needed”.","acceptedAnswer":{"@type":"Answer","text":"The content is members-only or age-restricted. Sign in to that site once from the app and retry."}},{"@type":"Question","name":"A site that used to work stopped working.","acceptedAnswer":{"@type":"Answer","text":"Sites change often. DriftFetch updates its engines automatically; if it’s still broken after a day or two, report it on GitHub."}},{"@type":"Question","name":"Does DriftFetch collect any data?","acceptedAnswer":{"@type":"Answer","text":"No. There’s no DriftFetch server. The app only talks to the sites you download from and to GitHub for engine updates."}},{"@type":"Question","name":"Is it safe to install?","acceptedAnswer":{"@type":"Answer","text":"The code is public and every release has a checksum you can verify. See the download page for how."}},{"@type":"Question","name":"Is downloading allowed?","acceptedAnswer":{"@type":"Answer","text":"Only save content you have the right to keep, and follow each site’s terms. DriftFetch doesn’t remove DRM or get around paywalls."}}]}]}
>

    <section data-tide="1" style="background:#010930;color:#f2f5ff;padding:clamp(56px,8vw,104px) clamp(20px,4vw,48px) 120px">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
        <h1 style="margin:0;font-size:clamp(42px,6vw,84px);line-height:1;font-weight:700;letter-spacing:-0.04em;max-width:13ch;text-wrap:balance">Questions people ask.</h1>
        <p style="margin:28px 0 0;max-width:32em;font-size:clamp(18px,1.6vw,20px);color:#c7cfea;text-wrap:pretty">Short answers first. If yours isn’t here, <a href="mailto:driftfetch@proton.me" style="color:#5fe3ee" class="hxpj8jr">email us</a> or open an issue on GitHub.</p>
      </div>
    </section>
    <section data-tide="1" style="background:#fff;padding:110px clamp(20px,4vw,48px)">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
        <div style="display:flex;flex-wrap:wrap;gap:24px 72px">
          <h2 style="margin:0;font-size:clamp(32px,4vw,52px);line-height:1.02;font-weight:800;letter-spacing:-0.04em;text-wrap:balance;font-size:clamp(28px,3vw,40px);flex:1 1 260px">Basics</h2>
          <div style="flex:2 1 460px;min-width:0;display:flex;flex-direction:column">
            <details style="border-top:1px solid rgba(1,9,48,0.14)"><summary style="list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 0;cursor:pointer;font-size:20px;font-weight:700;letter-spacing:-0.015em">Is DriftFetch really free?<span style="flex:none;display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" />
  <path d="M12 5v14" /></svg></span></span></summary><p style="margin:0 0 24px;max-width:38em;color:#353d5c;text-wrap:pretty">Yes. It’s MIT-licensed open source with no ads, trials or paid features.</p></details>
            <details style="border-top:1px solid rgba(1,9,48,0.14)"><summary style="list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 0;cursor:pointer;font-size:20px;font-weight:700;letter-spacing:-0.015em">Do I need an account?<span style="flex:none;display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" />
  <path d="M12 5v14" /></svg></span></span></summary><p style="margin:0 0 24px;max-width:38em;color:#353d5c;text-wrap:pretty">No. There’s nothing to sign up for.</p></details>
            <details style="border-top:1px solid rgba(1,9,48,0.14)"><summary style="list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 0;cursor:pointer;font-size:20px;font-weight:700;letter-spacing:-0.015em">Mac or Linux?<span style="flex:none;display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" />
  <path d="M12 5v14" /></svg></span></span></summary><p style="margin:0 0 24px;max-width:38em;color:#353d5c;text-wrap:pretty">Not yet. DriftFetch is built and tested for Windows 10 and 11 only.</p></details>
            <details style="border-top:1px solid rgba(1,9,48,0.14)"><summary style="list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 0;cursor:pointer;font-size:20px;font-weight:700;letter-spacing:-0.015em">Which sites does it work with?<span style="flex:none;display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" />
  <path d="M12 5v14" /></svg></span></span></summary><p style="margin:0 0 24px;max-width:38em;color:#353d5c;text-wrap:pretty">Sites supported by yt-dlp and gallery-dl, such as YouTube, Reddit, Vimeo and Internet Archive. See the supported sites page.</p></details>
          </div>
        </div>
      </div>
    </section>
    <section data-tide="1" style="background:#e4e9f4;padding:110px clamp(20px,4vw,48px)">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
        <div style="display:flex;flex-wrap:wrap;gap:24px 72px">
          <h2 style="margin:0;font-size:clamp(32px,4vw,52px);line-height:1.02;font-weight:800;letter-spacing:-0.04em;text-wrap:balance;font-size:clamp(28px,3vw,40px);flex:1 1 260px">Downloading</h2>
          <div style="flex:2 1 460px;min-width:0;display:flex;flex-direction:column">
            <details style="border-top:1px solid rgba(1,9,48,0.14)"><summary style="list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 0;cursor:pointer;font-size:20px;font-weight:700;letter-spacing:-0.015em">Where do my files go?<span style="flex:none;display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" />
  <path d="M12 5v14" /></svg></span></span></summary><p style="margin:0 0 24px;max-width:38em;color:#353d5c;text-wrap:pretty">To Downloads\DriftFetch by default, in a folder per site. You can change the folder, sorting and file names in Settings.</p></details>
            <details style="border-top:1px solid rgba(1,9,48,0.14)"><summary style="list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 0;cursor:pointer;font-size:20px;font-weight:700;letter-spacing:-0.015em">How do I download a playlist or album?<span style="flex:none;display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" />
  <path d="M12 5v14" /></svg></span></span></summary><p style="margin:0 0 24px;max-width:38em;color:#353d5c;text-wrap:pretty">Copy its link. DriftFetch shows every item with a thumbnail and you tick what you want.</p></details>
            <details style="border-top:1px solid rgba(1,9,48,0.14)"><summary style="list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 0;cursor:pointer;font-size:20px;font-weight:700;letter-spacing:-0.015em">Can I pick the quality?<span style="flex:none;display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" />
  <path d="M12 5v14" /></svg></span></span></summary><p style="margin:0 0 24px;max-width:38em;color:#353d5c;text-wrap:pretty">By default it takes the best quality available. You can set a maximum resolution or a preferred format in Settings.</p></details>
            <details style="border-top:1px solid rgba(1,9,48,0.14)"><summary style="list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 0;cursor:pointer;font-size:20px;font-weight:700;letter-spacing:-0.015em">Will it download the same thing twice?<span style="flex:none;display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" />
  <path d="M12 5v14" /></svg></span></span></summary><p style="margin:0 0 24px;max-width:38em;color:#353d5c;text-wrap:pretty">No. Links you’ve already saved are caught and marked “Already in list”.</p></details>
          </div>
        </div>
      </div>
    </section>
    <section data-tide="1" style="background:#fff;padding:110px clamp(20px,4vw,48px)">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
        <div style="display:flex;flex-wrap:wrap;gap:24px 72px">
          <h2 style="margin:0;font-size:clamp(32px,4vw,52px);line-height:1.02;font-weight:800;letter-spacing:-0.04em;text-wrap:balance;font-size:clamp(28px,3vw,40px);flex:1 1 260px">When something goes wrong</h2>
          <div style="flex:2 1 460px;min-width:0;display:flex;flex-direction:column">
            <details style="border-top:1px solid rgba(1,9,48,0.14)"><summary style="list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 0;cursor:pointer;font-size:20px;font-weight:700;letter-spacing:-0.015em">It says “Rate limited”. Is that an error?<span style="flex:none;display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" />
  <path d="M12 5v14" /></svg></span></span></summary><p style="margin:0 0 24px;max-width:38em;color:#353d5c;text-wrap:pretty">No. The site asked DriftFetch to slow down. It waits as long as it was told to and carries on by itself.</p></details>
            <details style="border-top:1px solid rgba(1,9,48,0.14)"><summary style="list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 0;cursor:pointer;font-size:20px;font-weight:700;letter-spacing:-0.015em">It says “Sign-in needed”.<span style="flex:none;display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" />
  <path d="M12 5v14" /></svg></span></span></summary><p style="margin:0 0 24px;max-width:38em;color:#353d5c;text-wrap:pretty">The content is members-only or age-restricted. Sign in to that site once from the app and retry.</p></details>
            <details style="border-top:1px solid rgba(1,9,48,0.14)"><summary style="list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 0;cursor:pointer;font-size:20px;font-weight:700;letter-spacing:-0.015em">A site that used to work stopped working.<span style="flex:none;display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" />
  <path d="M12 5v14" /></svg></span></span></summary><p style="margin:0 0 24px;max-width:38em;color:#353d5c;text-wrap:pretty">Sites change often. DriftFetch updates its engines automatically; if it’s still broken after a day or two, report it on GitHub.</p></details>
          </div>
        </div>
      </div>
    </section>
    <section data-tide="1" style="background:#e4e9f4;padding:110px clamp(20px,4vw,48px)">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
        <div style="display:flex;flex-wrap:wrap;gap:24px 72px">
          <h2 style="margin:0;font-size:clamp(32px,4vw,52px);line-height:1.02;font-weight:800;letter-spacing:-0.04em;text-wrap:balance;font-size:clamp(28px,3vw,40px);flex:1 1 260px">Privacy and safety</h2>
          <div style="flex:2 1 460px;min-width:0;display:flex;flex-direction:column">
            <details style="border-top:1px solid rgba(1,9,48,0.14)"><summary style="list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 0;cursor:pointer;font-size:20px;font-weight:700;letter-spacing:-0.015em">Does DriftFetch collect any data?<span style="flex:none;display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" />
  <path d="M12 5v14" /></svg></span></span></summary><p style="margin:0 0 24px;max-width:38em;color:#353d5c;text-wrap:pretty">No. There’s no DriftFetch server. The app only talks to the sites you download from and to GitHub for engine updates.</p></details>
            <details style="border-top:1px solid rgba(1,9,48,0.14)"><summary style="list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 0;cursor:pointer;font-size:20px;font-weight:700;letter-spacing:-0.015em">Is it safe to install?<span style="flex:none;display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" />
  <path d="M12 5v14" /></svg></span></span></summary><p style="margin:0 0 24px;max-width:38em;color:#353d5c;text-wrap:pretty">The code is public and every release has a checksum you can verify. See the download page for how.</p></details>
            <details style="border-top:1px solid rgba(1,9,48,0.14)"><summary style="list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 0;cursor:pointer;font-size:20px;font-weight:700;letter-spacing:-0.015em">Is downloading allowed?<span style="flex:none;display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" />
  <path d="M12 5v14" /></svg></span></span></summary><p style="margin:0 0 24px;max-width:38em;color:#353d5c;text-wrap:pretty">Only save content you have the right to keep, and follow each site’s terms. DriftFetch doesn’t remove DRM or get around paywalls.</p></details>
          </div>
        </div>
      </div>
    </section>
  

</Layout>
