---
import Layout from "../layouts/Layout.astro";
import { u, site, links } from "../data/site";
---
<Layout
  title="Supported sites – DriftFetch for Windows"
  description="DriftFetch saves videos and images from YouTube, Reddit, Vimeo and the many other sites supported by yt-dlp and gallery-dl."
  path="/sites"
  current="/sites"
  jsonld={[]}
>

    <section data-tide="1" style="background:#010930;color:#f2f5ff;padding:clamp(56px,8vw,104px) clamp(20px,4vw,48px) 120px">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
        <h1 style="margin:0;font-size:clamp(42px,6vw,84px);line-height:1;font-weight:700;letter-spacing:-0.04em;max-width:13ch;text-wrap:balance">Works with the sites you already use.</h1>
        <p style="margin:28px 0 0;max-width:32em;font-size:clamp(18px,1.6vw,20px);color:#c7cfea;text-wrap:pretty">DriftFetch is built on yt-dlp and gallery-dl, two open-source projects that between them understand well over a thousand sites. Here are the ones people use most.</p>
      </div>
    </section>
    <section data-tide="1" style="background:#fff;padding:110px clamp(20px,4vw,48px)">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
        <h2 style="margin:0;font-size:clamp(32px,4vw,52px);line-height:1.02;font-weight:800;letter-spacing:-0.04em;text-wrap:balance;margin-bottom:40px">Most popular</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:16px">
          <a href={u("/youtube")} style="display:flex;flex-direction:column;gap:10px;padding:28px;border-radius:12px;background:#e4e9f4;color:#010930" class="h1tpnlwu"><span style="display:flex;align-items:center;justify-content:space-between;font-size:26px;font-weight:800;letter-spacing:-0.03em">YouTube<span style="display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" />
  <path d="m12 5 7 7-7 7" /></svg></span></span></span><span style="color:#353d5c;text-wrap:pretty">Videos, playlists and channels in the best quality offered.</span></a>
          <a href={u("/reddit")} style="display:flex;flex-direction:column;gap:10px;padding:28px;border-radius:12px;background:#e4e9f4;color:#010930" class="h1tpnlwu"><span style="display:flex;align-items:center;justify-content:space-between;font-size:26px;font-weight:800;letter-spacing:-0.03em">Reddit<span style="display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" />
  <path d="m12 5 7 7-7 7" /></svg></span></span></span><span style="color:#353d5c;text-wrap:pretty">Videos with their sound, and image galleries in order.</span></a>
          <a href={u("/vimeo")} style="display:flex;flex-direction:column;gap:10px;padding:28px;border-radius:12px;background:#e4e9f4;color:#010930" class="h1tpnlwu"><span style="display:flex;align-items:center;justify-content:space-between;font-size:26px;font-weight:800;letter-spacing:-0.03em">Vimeo<span style="display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" />
  <path d="m12 5 7 7-7 7" /></svg></span></span></span><span style="color:#353d5c;text-wrap:pretty">Public and unlisted videos, in the quality the creator allows.</span></a>
        </div>
      </div>
    </section>
    <section data-tide="1" style="background:#e4e9f4;padding:110px clamp(20px,4vw,48px)">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:40px 72px">
          <h2 style="margin:0;font-size:clamp(32px,4vw,52px);line-height:1.02;font-weight:800;letter-spacing:-0.04em;text-wrap:balance">And many more</h2>
          <div style="display:flex;flex-direction:column">
            <ul style="list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:8px"><li style="padding:8px 14px;border-radius:999px;background:#fff;font-size:15px;font-weight:500">Internet Archive</li><li style="padding:8px 14px;border-radius:999px;background:#fff;font-size:15px;font-weight:500">Dailymotion</li><li style="padding:8px 14px;border-radius:999px;background:#fff;font-size:15px;font-weight:500">SoundCloud</li><li style="padding:8px 14px;border-radius:999px;background:#fff;font-size:15px;font-weight:500">Bandcamp</li><li style="padding:8px 14px;border-radius:999px;background:#fff;font-size:15px;font-weight:500">Twitch clips</li><li style="padding:8px 14px;border-radius:999px;background:#fff;font-size:15px;font-weight:500">Imgur</li><li style="padding:8px 14px;border-radius:999px;background:#fff;font-size:15px;font-weight:500">Flickr</li><li style="padding:8px 14px;border-radius:999px;background:#fff;font-size:15px;font-weight:500">DeviantArt</li><li style="padding:8px 14px;border-radius:999px;background:#fff;font-size:15px;font-weight:500">Tumblr</li><li style="padding:8px 14px;border-radius:999px;background:#fff;font-size:15px;font-weight:500">Bluesky</li><li style="padding:8px 14px;border-radius:999px;background:#fff;font-size:15px;font-weight:500">Pixiv</li><li style="padding:8px 14px;border-radius:999px;background:#fff;font-size:15px;font-weight:500">Newgrounds</li></ul>
            <p style="margin:24px 0 0;color:#353d5c;text-wrap:pretty">Full lists: <a href="https://github.com/yt-dlp/yt-dlp/blob/master/supportedsites.md" rel="noopener">yt-dlp supported sites</a> and <a href="https://github.com/mikf/gallery-dl/blob/master/docs/supportedsites.md" rel="noopener">gallery-dl supported sites</a>. Support depends on each site and can change when a site updates.</p></div>
        </div>
      </div>
    </section>
    <section data-tide="1" style="background:#fff;padding:110px clamp(20px,4vw,48px)">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:40px 72px">
          <h2 style="margin:0;font-size:clamp(32px,4vw,52px);line-height:1.02;font-weight:800;letter-spacing:-0.04em;text-wrap:balance">Good to know</h2>
          <div style="display:flex;flex-direction:column"><div style="display:flex;gap:18px;padding:22px 0 24px;border-top:1px solid rgba(1,9,48,0.14)"><span style="flex:none;width:40px;height:40px;border-radius:10px;background:#010930;color:#0cf3fe;display:flex;align-items:center;justify-content:center"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z" />
  <circle cx="16.5" cy="7.5" r=".5" fill="currentColor" /></svg></span></span><div><h3 style="margin:0 0 4px;font-size:20px;font-weight:700;letter-spacing:-0.015em">Some sites need a sign-in</h3><p style="margin:0;color:#353d5c;text-wrap:pretty">Members-only or age-restricted content asks you to sign in once inside the app. The sign-in stays encrypted on your PC.</p></div></div><div style="display:flex;gap:18px;padding:22px 0 24px;border-top:1px solid rgba(1,9,48,0.14)"><span style="flex:none;width:40px;height:40px;border-radius:10px;background:#010930;color:#0cf3fe;display:flex;align-items:center;justify-content:center"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 2 20 20" />
  <path d="M5 5a1 1 0 0 0-1 1v7c0 5 3.5 7.5 7.67 8.94a1 1 0 0 0 .67.01c2.35-.82 4.48-1.97 5.9-3.71" />
  <path d="M9.309 3.652A12.252 12.252 0 0 0 11.24 2.28a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1v7a9.784 9.784 0 0 1-.08 1.264" /></svg></span></span><div><h3 style="margin:0 0 4px;font-size:20px;font-weight:700;letter-spacing:-0.015em">No DRM, no paywalls</h3><p style="margin:0;color:#353d5c;text-wrap:pretty">DriftFetch doesn’t remove copy protection or get around payment. Streaming services like Netflix won’t work.</p></div></div><div style="display:flex;gap:18px;padding:22px 0 24px;border-top:1px solid rgba(1,9,48,0.14)"><span style="flex:none;width:40px;height:40px;border-radius:10px;background:#010930;color:#0cf3fe;display:flex;align-items:center;justify-content:center"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20v-9" />
  <path d="M14 7a4 4 0 0 1 4 4v3a6 6 0 0 1-12 0v-3a4 4 0 0 1 4-4z" />
  <path d="M14.12 3.88 16 2" />
  <path d="M21 21a4 4 0 0 0-3.81-4" />
  <path d="M21 5a4 4 0 0 1-3.55 3.97" />
  <path d="M22 13h-4" />
  <path d="M3 21a4 4 0 0 1 3.81-4" />
  <path d="M3 5a4 4 0 0 0 3.55 3.97" />
  <path d="M6 13H2" />
  <path d="m8 2 1.88 1.88" />
  <path d="M9 7.13V6a3 3 0 1 1 6 0v1.13" /></svg></span></span><div><h3 style="margin:0 0 4px;font-size:20px;font-weight:700;letter-spacing:-0.015em">A site stopped working?</h3><p style="margin:0;color:#353d5c;text-wrap:pretty">Sites change. Engine updates usually fix it within days. If not, report it on GitHub.</p></div></div></div>
        </div>
      </div>
    </section>
  

</Layout>
