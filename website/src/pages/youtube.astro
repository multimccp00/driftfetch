---
import Layout from "../layouts/Layout.astro";
import { u, site, links } from "../data/site";
---
<Layout
  title="Save YouTube videos to your PC – DriftFetch for Windows"
  description="Copy a YouTube link and DriftFetch saves the video in the best quality YouTube offers. Playlists wait for you to pick what you want."
  path="/youtube"
  current="/sites"
  jsonld={[{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Does it need a YouTube account?","acceptedAnswer":{"@type":"Answer","text":"No. Public videos download without signing in. Age-restricted videos may ask you to sign in once inside the app."}},{"@type":"Question","name":"Why does it sometimes say “rate limited”?","acceptedAnswer":{"@type":"Answer","text":"YouTube occasionally asks downloaders to slow down. DriftFetch waits as long as it was asked to and carries on by itself."}},{"@type":"Question","name":"Is it allowed?","acceptedAnswer":{"@type":"Answer","text":"Only save videos you have the right to keep, such as your own uploads or videos licensed for reuse, and follow YouTube’s terms."}}]}]}
>

    <section data-tide="1" style="background:#010930;color:#f2f5ff;padding:clamp(56px,8vw,104px) clamp(20px,4vw,48px) 110px">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
        <p style="margin:0 0 20px;font-size:15px;font-weight:600;color:#5fe3ee">DriftFetch for YouTube</p>
        <h1 style="margin:0;font-size:clamp(42px,6vw,84px);line-height:1;font-weight:700;letter-spacing:-0.04em;max-width:13ch;text-wrap:balance">Save YouTube videos to your PC.</h1>
        <p style="margin:28px 0 0;max-width:32em;font-size:clamp(18px,1.6vw,20px);color:#c7cfea;text-wrap:pretty">Copy a YouTube link and DriftFetch saves the video in the best quality YouTube offers. Playlists wait for you to pick what you want.</p>
        <div style="margin-top:36px;display:flex;flex-wrap:wrap;align-items:center;gap:14px 20px">
          <a href={u("/#download")} style="display:flex;align-items:center;gap:10px;height:52px;padding:0 22px 0 18px;border-radius:8px;background:#0b67fe;color:#fff;font-size:16px;font-weight:600" class="h1ifpqlp"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 17V3" />
  <path d="m6 11 6 6 6-6" />
  <path d="M19 21H5" /></svg></span>Download for Windows</a>
          <span style="font-size:14px;color:#8a96bd">Free and open source · Windows 10 and 11</span>
        </div>
      </div>
    </section>
    <section data-tide="1" style="padding:110px clamp(20px,4vw,48px)">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
        <h2 style="margin:0;font-size:clamp(32px,4vw,52px);line-height:1.02;font-weight:800;letter-spacing:-0.04em;text-wrap:balance;max-width:16ch;margin-bottom:48px">How to save from YouTube <span style="background:linear-gradient(transparent 64%,#0cf3fe 64%,#0cf3fe 90%,transparent 90%);padding:0 2px">in one step</span></h2>
        <ol style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:32px 40px">
          <li style="display:flex;flex-direction:column;gap:10px;padding-top:20px;border-top:1px solid rgba(1,9,48,0.14)"><span style="font-size:15px;font-weight:700;color:#0a55d6">01</span><h3 style="margin:0;font-size:22px;font-weight:700;letter-spacing:-0.02em">Copy the link</h3><p style="margin:0;color:#353d5c">Like <span style="font-family:'JetBrains Mono',monospace;font-size:14px;background:#e4e9f4;padding:1px 6px;border-radius:4px;overflow-wrap:anywhere">youtube.com/watch?v=aBcD123</span>, from your browser or the share button.</p></li>
          <li style="display:flex;flex-direction:column;gap:10px;padding-top:20px;border-top:1px solid rgba(1,9,48,0.14)"><span style="font-size:15px;font-weight:700;color:#0a55d6">02</span><h3 style="margin:0;font-size:22px;font-weight:700;letter-spacing:-0.02em">DriftFetch picks it up</h3><p style="margin:0;color:#353d5c">It’s waiting in your tray. No pasting, no browser extension.</p></li>
          <li style="display:flex;flex-direction:column;gap:10px;padding-top:20px;border-top:1px solid rgba(1,9,48,0.14)"><span style="font-size:15px;font-weight:700;color:#0a55d6">03</span><h3 style="margin:0;font-size:22px;font-weight:700;letter-spacing:-0.02em">It’s on your PC</h3><p style="margin:0;color:#353d5c">In Downloads\DriftFetch\youtube.com, ready to open.</p></li>
        </ol>
      </div>
    </section>
    <section data-tide="1" style="background:#e4e9f4;padding:110px clamp(20px,4vw,48px)">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
        <h2 style="margin:0;font-size:clamp(32px,4vw,52px);line-height:1.02;font-weight:800;letter-spacing:-0.04em;text-wrap:balance;margin-bottom:48px">What you can save</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:20px">
          <div style="display:flex;flex-direction:column;gap:12px;padding:28px;border-radius:12px;background:#fff"><span style="width:40px;height:40px;border-radius:10px;background:#010930;color:#0cf3fe;display:flex;align-items:center;justify-content:center"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" />
  <path d="M7 3v18" />
  <path d="M3 7.5h4" />
  <path d="M3 12h18" />
  <path d="M3 16.5h4" />
  <path d="M17 3v18" />
  <path d="M17 7.5h4" />
  <path d="M17 16.5h4" /></svg></span></span><h3 style="margin:0;font-size:21px;font-weight:700;letter-spacing:-0.015em">Single videos</h3><p style="margin:0;color:#353d5c;text-wrap:pretty">Up to the highest resolution the video was uploaded in, with sound joined in without re-encoding.</p></div>
          <div style="display:flex;flex-direction:column;gap:12px;padding:28px;border-radius:12px;background:#fff"><span style="width:40px;height:40px;border-radius:10px;background:#010930;color:#0cf3fe;display:flex;align-items:center;justify-content:center"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 5h8" />
  <path d="M13 12h8" />
  <path d="M13 19h8" />
  <path d="m3 17 2 2 4-4" />
  <path d="m3 7 2 2 4-4" /></svg></span></span><h3 style="margin:0;font-size:21px;font-weight:700;letter-spacing:-0.015em">Playlists and channels</h3><p style="margin:0;color:#353d5c;text-wrap:pretty">You get a list with thumbnails and tick what you want. Nothing floods your drive.</p></div>
          <div style="display:flex;flex-direction:column;gap:12px;padding:28px;border-radius:12px;background:#fff"><span style="width:40px;height:40px;border-radius:10px;background:#010930;color:#0cf3fe;display:flex;align-items:center;justify-content:center"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13" />
  <circle cx="6" cy="18" r="3" />
  <circle cx="18" cy="16" r="3" /></svg></span></span><h3 style="margin:0;font-size:21px;font-weight:700;letter-spacing:-0.015em">Audio only</h3><p style="margin:0;color:#353d5c;text-wrap:pretty">Save just the sound as a separate file when that’s all you need.</p></div>
        </div>
      </div>
    </section>
    <section data-tide="1" style="padding:110px clamp(20px,4vw,48px)">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:40px 72px">
        <h2 style="margin:0;font-size:clamp(32px,4vw,52px);line-height:1.02;font-weight:800;letter-spacing:-0.04em;text-wrap:balance">YouTube questions</h2>
        <div>
          <div style="padding:22px 0 26px;border-top:1px solid rgba(1,9,48,0.12)"><h3 style="margin:0 0 6px;font-size:20px;font-weight:700;letter-spacing:-0.015em">Does it need a YouTube account?</h3><p style="margin:0;color:#353d5c;text-wrap:pretty">No. Public videos download without signing in. Age-restricted videos may ask you to sign in once inside the app.</p></div>
          <div style="padding:22px 0 26px;border-top:1px solid rgba(1,9,48,0.12)"><h3 style="margin:0 0 6px;font-size:20px;font-weight:700;letter-spacing:-0.015em">Why does it sometimes say “rate limited”?</h3><p style="margin:0;color:#353d5c;text-wrap:pretty">YouTube occasionally asks downloaders to slow down. DriftFetch waits as long as it was asked to and carries on by itself.</p></div>
          <div style="padding:22px 0 26px;border-top:1px solid rgba(1,9,48,0.12)"><h3 style="margin:0 0 6px;font-size:20px;font-weight:700;letter-spacing:-0.015em">Is it allowed?</h3><p style="margin:0;color:#353d5c;text-wrap:pretty">Only save videos you have the right to keep, such as your own uploads or videos licensed for reuse, and follow YouTube’s terms.</p></div>
        </div>
      </div>
    </section>
    <section data-tide="1" style="background:#0b67fe;color:#fff;padding:90px clamp(20px,4vw,48px)">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:28px">
        <div><h2 style="margin:0;font-size:clamp(32px,4vw,52px);line-height:1.02;font-weight:800;letter-spacing:-0.04em;text-wrap:balance">Also works with</h2><p style="margin:10px 0 0;color:#e8efff">And the many other sites yt-dlp and gallery-dl support.</p></div>
        <div style="display:flex;flex-wrap:wrap;gap:10px"><a href={u("/reddit")} style="display:flex;align-items:center;gap:8px;height:48px;padding:0 20px;border-radius:8px;background:#010930;color:#fff;font-weight:600" class="h1xn00in">Reddit<span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" />
  <path d="m12 5 7 7-7 7" /></svg></span></a><a href={u("/vimeo")} style="display:flex;align-items:center;gap:8px;height:48px;padding:0 20px;border-radius:8px;background:#010930;color:#fff;font-weight:600" class="h1xn00in">Vimeo<span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" />
  <path d="m12 5 7 7-7 7" /></svg></span></a></div>
      </div>
    </section>
  

</Layout>
