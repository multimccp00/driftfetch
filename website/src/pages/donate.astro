---
import Layout from "../layouts/Layout.astro";
import { u, site, links } from "../data/site";
---
<Layout
  title="Support DriftFetch – Buy me a coffee"
  description="DriftFetch is free, with no ads and no tracking. If it saves you time, you can buy the developer a coffee."
  path="/donate"
  current="/donate"
  jsonld={[]}
>

    <section data-tide="1" style="background:#010930;color:#f2f5ff;padding:clamp(56px,8vw,104px) clamp(20px,4vw,48px) 110px">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:48px 72px;align-items:end">
        <div>
          <h1 style="margin:0;font-size:clamp(42px,6vw,84px);line-height:1;font-weight:700;letter-spacing:-0.04em;max-width:11ch;text-wrap:balance">Keep DriftFetch free.</h1>
          <p style="margin:28px 0 0;max-width:30em;font-size:clamp(18px,1.6vw,20px);color:#c7cfea;text-wrap:pretty">No ads, no tracking and no paid version means the only funding is people who find it useful. If it’s saved you some time, a coffee helps keep it going.</p>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px;align-items:flex-start">
          <a href={links.donate} target="_blank" rel="noopener" style="display:flex;align-items:center;gap:10px;height:56px;padding:0 24px 0 20px;border-radius:10px;background:#FFDD00;color:#010930;font-size:17px;font-weight:700" class="hdsx3n9"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 2v2" />
  <path d="M14 2v2" />
  <path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1" />
  <path d="M6 2v2" /></svg></span>Buy me a coffee</a>
          <span style="font-size:14px;color:#8a96bd">Opens Buy Me a Coffee in a new tab. No account needed to give.</span>
        </div>
      </div>
    </section>
    <section data-tide="1" style="padding:110px clamp(20px,4vw,48px)">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
        <h2 style="margin:0;font-size:clamp(32px,4vw,52px);line-height:1.02;font-weight:800;letter-spacing:-0.04em;text-wrap:balance;margin-bottom:40px">Pick a size</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:16px">
          <a href={links.donate} target="_blank" rel="noopener" style="display:flex;flex-direction:column;gap:6px;padding:26px 24px;border-radius:12px;background:#FFDD00;color:#010930;box-shadow:0 0 0 1px transparent" class="h1jxu2s7"><span style="display:flex;gap:4px;color:#010930"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 2v2" />
  <path d="M14 2v2" />
  <path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1" />
  <path d="M6 2v2" /></svg></span></span><span style="margin-top:8px;font-size:21px;font-weight:700;letter-spacing:-0.015em">One coffee</span><span style="font-size:15px;color:#353d5c">A quick thank-you</span></a>
          <a href={links.donate} target="_blank" rel="noopener" style="display:flex;flex-direction:column;gap:6px;padding:26px 24px;border-radius:12px;background:#fff;color:#010930;box-shadow:0 0 0 1px rgba(1,9,48,0.14)" class="h1jxu2s7"><span style="display:flex;gap:4px;color:#010930"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 2v2" />
  <path d="M14 2v2" />
  <path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1" />
  <path d="M6 2v2" /></svg></span><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 2v2" />
  <path d="M14 2v2" />
  <path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1" />
  <path d="M6 2v2" /></svg></span><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 2v2" />
  <path d="M14 2v2" />
  <path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1" />
  <path d="M6 2v2" /></svg></span></span><span style="margin-top:8px;font-size:21px;font-weight:700;letter-spacing:-0.015em">Three coffees</span><span style="font-size:15px;color:#353d5c">Covers a month of the website</span></a>
          <a href={links.donate} target="_blank" rel="noopener" style="display:flex;flex-direction:column;gap:6px;padding:26px 24px;border-radius:12px;background:#fff;color:#010930;box-shadow:0 0 0 1px rgba(1,9,48,0.14)" class="h1jxu2s7"><span style="display:flex;gap:4px;color:#010930"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m17 2 4 4-4 4" />
  <path d="M3 11v-1a4 4 0 0 1 4-4h14" />
  <path d="m7 22-4-4 4-4" />
  <path d="M21 13v1a4 4 0 0 1-4 4H3" /></svg></span><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 2v2" />
  <path d="M14 2v2" />
  <path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1" />
  <path d="M6 2v2" /></svg></span></span><span style="margin-top:8px;font-size:21px;font-weight:700;letter-spacing:-0.015em">Every month</span><span style="font-size:15px;color:#353d5c">Become a member and help plan ahead</span></a>
        </div>
        <p style="margin:20px 0 0;font-size:15px;color:#596180">You choose the exact amount on the next page. Payments, receipts and refunds are handled by Buy Me a Coffee.</p>
      </div>
    </section>
    <section data-tide="1" style="background:#e4e9f4;padding:110px clamp(20px,4vw,48px)">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:40px 72px">
        <h2 style="margin:0;font-size:clamp(32px,4vw,52px);line-height:1.02;font-weight:800;letter-spacing:-0.04em;text-wrap:balance">Where it <span style="background:linear-gradient(transparent 64%,#0cf3fe 64%,#0cf3fe 90%,transparent 90%);padding:0 2px">goes</span></h2>
        <div style="display:flex;flex-direction:column">
          <div style="display:flex;gap:18px;padding:22px 0 24px;border-top:1px solid rgba(1,9,48,0.14)"><span style="flex:none;width:40px;height:40px;border-radius:10px;background:#010930;color:#0cf3fe;display:flex;align-items:center;justify-content:center"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
  <path d="m9 12 2 2 4-4" /></svg></span></span><div><h3 style="margin:0 0 4px;font-size:20px;font-weight:700;letter-spacing:-0.015em">Code signing</h3><p style="margin:0;color:#353d5c;text-wrap:pretty">A signing certificate so Windows trusts the installer and stops showing scary warnings.</p></div></div>
          <div style="display:flex;gap:18px;padding:22px 0 24px;border-top:1px solid rgba(1,9,48,0.14)"><span style="flex:none;width:40px;height:40px;border-radius:10px;background:#010930;color:#0cf3fe;display:flex;align-items:center;justify-content:center"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" />
  <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
  <path d="M2 12h20" /></svg></span></span><div><h3 style="margin:0 0 4px;font-size:20px;font-weight:700;letter-spacing:-0.015em">The website and domain</h3><p style="margin:0;color:#353d5c;text-wrap:pretty">Hosting, the domain and the self-hosted fonts. No ad networks to pay for it.</p></div></div>
          <div style="display:flex;gap:18px;padding:22px 0 24px;border-top:1px solid rgba(1,9,48,0.14)"><span style="flex:none;width:40px;height:40px;border-radius:10px;background:#010930;color:#0cf3fe;display:flex;align-items:center;justify-content:center"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" />
  <path d="M12 6v6l4 2" /></svg></span></span><div><h3 style="margin:0 0 4px;font-size:20px;font-weight:700;letter-spacing:-0.015em">Time</h3><p style="margin:0;color:#353d5c;text-wrap:pretty">Keeping up when sites change, answering issues and adding the things people ask for.</p></div></div>
        </div>
      </div>
    </section>
    <section data-tide="1" style="padding:110px clamp(20px,4vw,48px)">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
        <h2 style="margin:0;font-size:clamp(32px,4vw,52px);line-height:1.02;font-weight:800;letter-spacing:-0.04em;text-wrap:balance;margin-bottom:40px">No money? These help just as much.</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:32px 40px">
          <a href={links.source} style="display:flex;flex-direction:column;gap:8px;padding-top:20px;border-top:2px solid #010930;color:#010930" class="hetmxgi"><span style="display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" /></svg></span></span><span style="font-size:20px;font-weight:700;letter-spacing:-0.015em">Star it on GitHub</span><span style="color:#353d5c">It helps other people find it.</span></a>
          <a href={links.issues} style="display:flex;flex-direction:column;gap:8px;padding-top:20px;border-top:2px solid #010930;color:#010930" class="hetmxgi"><span style="display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20v-9" />
  <path d="M14 7a4 4 0 0 1 4 4v3a6 6 0 0 1-12 0v-3a4 4 0 0 1 4-4z" />
  <path d="M14.12 3.88 16 2" />
  <path d="M21 21a4 4 0 0 0-3.81-4" />
  <path d="M21 5a4 4 0 0 1-3.55 3.97" />
  <path d="M22 13h-4" />
  <path d="M3 21a4 4 0 0 1 3.81-4" />
  <path d="M3 5a4 4 0 0 0 3.55 3.97" />
  <path d="M6 13H2" />
  <path d="m8 2 1.88 1.88" />
  <path d="M9 7.13V6a3 3 0 1 1 6 0v1.13" /></svg></span></span><span style="font-size:20px;font-weight:700;letter-spacing:-0.015em">Report a problem</span><span style="color:#353d5c">A clear bug report is worth a lot.</span></a>
          <a href={links.issues} style="display:flex;flex-direction:column;gap:8px;padding-top:20px;border-top:2px solid #010930;color:#010930" class="hetmxgi"><span style="display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 8 6 6" />
  <path d="m4 14 6-6 2-3" />
  <path d="M2 5h12" />
  <path d="M7 2h1" />
  <path d="m22 22-5-10-5 10" />
  <path d="M14 18h6" /></svg></span></span><span style="font-size:20px;font-weight:700;letter-spacing:-0.015em">Help translate</span><span style="color:#353d5c">Make DriftFetch speak your language.</span></a>
          <a href={u("/#faq")} style="display:flex;flex-direction:column;gap:8px;padding-top:20px;border-top:2px solid #010930;color:#010930" class="hetmxgi"><span style="display:flex;color:#0a55d6"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3" />
  <circle cx="6" cy="12" r="3" />
  <circle cx="18" cy="19" r="3" />
  <line x1="8.59" x2="15.42" y1="13.51" y2="17.49" />
  <line x1="15.41" x2="8.59" y1="6.51" y2="10.49" /></svg></span></span><span style="font-size:20px;font-weight:700;letter-spacing:-0.015em">Tell a friend</span><span style="color:#353d5c">Word of mouth is the only marketing.</span></a>
        </div>
      </div>
    </section>
    <section data-tide="1" style="background:#0b67fe;color:#fff;padding:90px clamp(20px,4vw,48px)">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:28px 56px">
        <div><h3 style="margin:0 0 6px;font-size:20px;font-weight:700">Do donors get extra features?</h3><p style="margin:0;color:#e8efff">No. Everything is free for everyone, and it stays that way.</p></div>
        <div><h3 style="margin:0 0 6px;font-size:20px;font-weight:700">Is it private?</h3><p style="margin:0;color:#e8efff">This page loads nothing from Buy Me a Coffee. Their site only opens when you click, and their own privacy policy applies there.</p></div>
        <div><h3 style="margin:0 0 6px;font-size:20px;font-weight:700">Is it tax-deductible?</h3><p style="margin:0;color:#e8efff">No. DriftFetch is a personal project, not a charity.</p></div>
      </div>
    </section>
  

</Layout>
