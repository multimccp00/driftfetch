---
import Layout from "../layouts/Layout.astro";
import { u, site, links } from "../data/site";
import Demo from "../components/Demo.astro";
import { Icon } from "../components/icon";
import { SAMPLES, FAQ, shareLinks } from "../data/home";
const chips = SAMPLES;
const faq = FAQ;
const shares = shareLinks(site.url);
---
<Layout
  title="DriftFetch – Free video and image downloader for Windows"
  description="Copy a link and DriftFetch saves the video or gallery to your PC. Free, open source (MIT) and private: no account, no ads, no tracking. For Windows 10 and 11."
  path="/"
  current=null
  jsonld={[{"@context":"https://schema.org","@type":"SoftwareApplication","name":"DriftFetch","operatingSystem":"Windows 10, Windows 11","applicationCategory":"MultimediaApplication","softwareVersion":"__VERSION__","description":"A free, open-source video and image downloader for Windows that picks up links you copy.","license":"https://opensource.org/licenses/MIT","isAccessibleForFree":true,"offers":{"@type":"Offer","price":"0","priceCurrency":"EUR"},"downloadUrl":"https://driftfetch.app/download","url":"https://driftfetch.app/"},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is DriftFetch really free?","acceptedAnswer":{"@type":"Answer","text":"Yes. DriftFetch is MIT-licensed open source with no ads, trials or paid features."}},{"@type":"Question","name":"Which sites does it work with?","acceptedAnswer":{"@type":"Answer","text":"Sites supported by yt-dlp and gallery-dl, such as YouTube, Vimeo, Internet Archive and Dailymotion. Some sites need you to sign in once inside the app."}},{"@type":"Question","name":"Do I need an account?","acceptedAnswer":{"@type":"Answer","text":"No. There is nothing to sign up for and no DriftFetch server."}},{"@type":"Question","name":"Does it work on Mac or Linux?","acceptedAnswer":{"@type":"Answer","text":"Not yet. DriftFetch is built and tested for Windows 10 and 11."}},{"@type":"Question","name":"Where do my files go?","acceptedAnswer":{"@type":"Answer","text":"To Downloads\\DriftFetch by default, sorted into a folder per site. You can change this in Settings."}},{"@type":"Question","name":"Is downloading allowed?","acceptedAnswer":{"@type":"Answer","text":"Only save content you have the right to keep, and follow each site’s terms. DriftFetch does not remove DRM or get around paywalls."}}]}]}
>

    <div style="position:relative">

      <section data-tide="1" id="top" aria-labelledby="h-hero" style="position:relative;background:#010930;color:#f2f5ff;padding:clamp(56px,8vw,112px) clamp(20px,4vw,48px) 150px">
        <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto;box-sizing:border-box;padding-right:var(--padr)">
          <div class="hero-art only-wide" aria-hidden="true">
          <svg class="ha-wave" viewBox="0 0 880 120" preserveAspectRatio="none"><defs><linearGradient id="haw" x1="0" x2="1"><stop offset="0" stop-color="#0b67fe" stop-opacity="0"/><stop offset=".5" stop-color="#0cf3fe"/><stop offset="1" stop-color="#0b67fe" stop-opacity="0"/></linearGradient></defs><path d="M0 60 C 55 10, 110 10, 165 60 S 275 110, 330 60 S 440 10, 495 60 S 605 110, 660 60 S 770 10, 825 60 S 880 90, 880 60" fill="none" stroke="url(#haw)" stroke-width="2.5" stroke-linecap="round"/></svg>
          <div class="ha-pill"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><span>youtube.com/watch?v=aBcD123</span></div>
          <svg class="ha-arrow" width="120" height="110" viewBox="0 0 120 110" fill="none" stroke="#0cf3fe" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path pathLength="1" d="M10 6 C 90 0, 112 30, 96 80"/><path pathLength="1" d="M82 68 L96 84 L108 66"/></svg>
          <div class="ha-card ha-a"><img src={u("/hero-thumb-1.webp")} width="560" height="420" alt=""></div>
          <div class="ha-card ha-b"><img src={u("/hero-thumb-2.webp")} width="560" height="420" alt=""></div>
          <div class="ha-card ha-c"><img src={u("/hero-thumb-3.webp")} width="560" height="420" alt=""><span class="ha-bar"><i></i></span><span class="ha-saved"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Saved</span></div>
        </div>
          <h1 id="h-hero" style="margin:0;font-size:clamp(44px,6vw,86px);line-height:1;font-weight:700;letter-spacing:-0.04em;max-width:11ch;text-wrap:balance">Copy a link and it’s on your PC.</h1>
          <div style="margin-top:44px;display:flex">
            <button id="hero-link" data-url="https://youtube.com/watch?v=aBcD123" title="Copy this link" style="max-width:100%;padding:3px 6px;border:none;border-radius:2px;background:#0cf3fe;color:#010930;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:clamp(17px,2vw,26px);line-height:1.3;text-align:left;overflow-wrap:anywhere;cursor:pointer;user-select:text" class="h1eknsu4">youtube.com/watch?v=aBcD123</button>
          </div>
          <div id="hero-hint">
            <p style="margin:14px 0 0;display:flex;flex-wrap:wrap;align-items:center;gap:6px;font-size:15px;color:#8a96bd">That’s the whole interface. Click the link, or select it and press <span style="padding:2px 8px;border-radius:5px;background:#0e1a4a;box-shadow:0 0 0 1px rgba(255,255,255,0.16),0 2px 0 rgba(255,255,255,0.16);font-weight:600;color:#f2f5ff;font-size:13px">Ctrl</span>+<span style="padding:2px 8px;border-radius:5px;background:#0e1a4a;box-shadow:0 0 0 1px rgba(255,255,255,0.16),0 2px 0 rgba(255,255,255,0.16);font-weight:600;color:#f2f5ff;font-size:13px">C</span></p>
          </div>
          <div id="hero-picked" hidden>
            <p role="status" style="margin:14px 0 0;display:flex;align-items:center;gap:8px;font-size:15px;color:#5fcf98"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg></span>Copied. DriftFetch would already be saving it. It’s waiting in the demo further down.</p>
          </div>
          <p style="margin:64px 0 0;max-width:28em;font-size:clamp(18px,1.6vw,20px);line-height:1.55;color:#c7cfea;text-wrap:pretty">DriftFetch waits in your tray. When you copy a video or gallery link, it finds the best version and saves it. No account, no ads, and nobody watching.</p>
          <div style="margin-top:28px;display:flex;flex-direction:column;gap:10px;align-items:flex-start">
            <a href="#download" style="display:flex;align-items:center;gap:10px;height:52px;padding:0 22px 0 18px;border-radius:8px;background:#0b67fe;color:#fff;font-size:16px;font-weight:600" class="h1ifpqlp"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 17V3" />
  <path d="m6 11 6 6 6-6" />
  <path d="M19 21H5" /></svg></span>Download for Windows</a>
            <span style="font-size:14px;color:#8a96bd">Free and open source · Windows 10 and 11 · Version {site.version}</span>
          </div>
        </div>
      </section>

      <section data-tide="1" id="how" aria-labelledby="h-how" style="position:relative;background:#fff;padding:150px clamp(20px,4vw,48px) 120px">
        <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto;box-sizing:border-box;padding-right:var(--padr)">
          <h2 id="h-how" style="margin:0;font-size:clamp(36px,4.4vw,58px);line-height:1;font-weight:800;letter-spacing:-0.04em;text-wrap:balance;max-width:14ch;margin-bottom:40px">Three steps. You only do the <span style="background:linear-gradient(transparent 64%,#0cf3fe 64%,#0cf3fe 90%,transparent 90%);padding:0 2px">first one</span>.</h2>
          <ol style="list-style:none;margin:0;padding:0">
          <li style="padding:28px 0 34px;border-top:1px solid rgba(1,9,48,0.12)">
            <div style="display:flex;align-items:baseline;gap:16px"><span style="font-size:15px;font-weight:700;color:#0a55d6">01</span><h3 style="margin:0;font-size:clamp(26px,2.6vw,34px);font-weight:700;letter-spacing:-0.025em">Copy a link</h3></div>
            <p style="margin:14px 0 0 34px;max-width:30em;color:#353d5c;font-size:18px;text-wrap:pretty">From your browser, a chat or an email. Anywhere Windows lets you copy. That’s your part done.</p>
          </li>
          <li style="padding:28px 0 34px;border-top:1px solid rgba(1,9,48,0.12)">
            <div style="display:flex;align-items:baseline;gap:16px"><span style="font-size:15px;font-weight:700;color:#0a55d6">02</span><h3 style="margin:0;font-size:clamp(26px,2.6vw,34px);font-weight:700;letter-spacing:-0.025em">DriftFetch finds it</h3></div>
            <p style="margin:14px 0 0 34px;max-width:30em;color:#353d5c;font-size:18px;text-wrap:pretty">It checks what the link points to and picks the best quality the site offers. Albums and playlists wait for you to choose.</p>
          </li>
          <li style="padding:28px 0 34px;border-top:1px solid rgba(1,9,48,0.12)">
            <div style="display:flex;align-items:baseline;gap:16px"><span style="font-size:15px;font-weight:700;color:#0a55d6">03</span><h3 style="margin:0;font-size:clamp(26px,2.6vw,34px);font-weight:700;letter-spacing:-0.025em">It’s on your PC</h3></div>
            <p style="margin:14px 0 0 34px;max-width:30em;color:#353d5c;font-size:18px;text-wrap:pretty">Saved to Downloads\\DriftFetch, sorted by site. Open the file or its folder straight from the list.</p>
          </li>
          </ol>
        </div>
      </section>

      <section data-tide="1" id="try" aria-labelledby="h-try" style="position:relative;padding:150px clamp(20px,4vw,48px) 150px;background:#e4e9f4;color:#010930">
        <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto;display:grid;grid-template-columns:var(--trycols);gap:56px 60px;align-items:center">
          <div style="min-width:0">
          <h2 id="h-try" style="margin:0;font-size:clamp(36px,4.4vw,58px);line-height:1;font-weight:800;letter-spacing:-0.04em;text-wrap:balance;max-width:13ch">Go on, try it on <span style="background:linear-gradient(transparent 64%,#0cf3fe 64%,#0cf3fe 90%,transparent 90%);padding:0 2px">this page</span>.</h2>
          <p style="margin:20px 0 0;color:#353d5c;max-width:30em;font-size:18px;text-wrap:pretty">This page listens for copied links the way the app does. Click a link below, or select one and press Ctrl+C, and watch it land.</p>
          <ul style="list-style:none;margin:32px 0 0;padding:0;display:flex;flex-direction:column;gap:8px">
            {chips.map((c) => (<>
              <li style="display:flex"><button data-chip data-url={c.url} title="Copy this link" style="display:flex;align-items:center;gap:12px;max-width:100%;height:48px;padding:0 16px;border-radius:10px;border:1px solid rgba(1,9,48,0.18);background:#fff;color:#010930;font-family:'JetBrains Mono',monospace;font-size:13.5px;cursor:pointer;user-select:text;text-align:left" class="h1vo4cca">
                <span style="color:#0a55d6;display:flex;flex:none"><Fragment set:html={Icon(c.icon, 15)} /></span><span style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{c.label}</span><span style="font-family:'Schibsted Grotesk Variable',sans-serif;font-size:13px;color:#596180;flex:none;margin-left:8px">{c.hint}</span>
              </button></li>
            </>))}
          </ul>
          </div>
          <div style="min-width:0"><Demo /></div>
        </div>
      </section>

    </div>

    <section data-tide="1" id="app" aria-labelledby="h-app" style="position:relative;padding:150px clamp(20px,4vw,48px) 150px;background:#0b67fe;color:#fff">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:20px 72px;align-items:end;margin-bottom:56px">
          <h2 id="h-app" style="margin:0;font-size:clamp(36px,4.4vw,58px);line-height:1;font-weight:800;letter-spacing:-0.04em;text-wrap:balance">And when you want the details, they’re all there.</h2>
          <p style="margin:0;color:#e8efff;max-width:30em;font-size:18px;text-wrap:pretty">Every download in one list, with filters, a details panel and settings in plain words. This is the real interface, so click around.</p>
        </div>
        <img src={u("/app.png")} width="1380" height="880" loading="lazy" alt="The DriftFetch window: one list of downloads with filters, a details panel and settings." style="display:block;width:100%;height:auto;aspect-ratio:1380/880;border-radius:10px;background:#0b0e17;box-shadow:0 0 0 1px rgba(1,9,48,0.3),0 40px 80px -30px rgba(1,9,48,0.65)">
      </div>
    </section>


    <section data-tide="1" id="faq" aria-labelledby="h-faq" style="position:relative;background:#fff;padding:170px clamp(20px,4vw,48px) 120px">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto">
        <h2 id="h-faq" style="margin:0 0 56px;font-size:clamp(36px,4.6vw,60px);line-height:1;font-weight:800;letter-spacing:-0.04em">Questions people ask</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:0 72px">
          {faq.map((f) => (<>
            <div style="padding:26px 0 30px;border-top:1px solid rgba(1,9,48,0.12)">
              <h3 style="margin:0 0 8px;font-size:21px;font-weight:700;letter-spacing:-0.015em">{f.q}</h3>
              <p style="margin:0;color:#353d5c;text-wrap:pretty">{f.a}</p>
            </div>
          </>))}
        </div>
        <div style="margin-top:72px;padding:28px 0 0;border-top:2px solid #010930;display:flex;flex-wrap:wrap;align-items:center;gap:20px 40px">
          <div style="flex:1 1 340px;min-width:0">
            <h3 style="margin:0;font-size:24px;font-weight:700;letter-spacing:-0.02em">Know someone who still screen-records videos?</h3>
            <p style="margin:4px 0 0;color:#353d5c">DriftFetch has no marketing budget. Passing it on is how it grows.</p>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:8px">
            <button id="share-copy" style="display:flex;align-items:center;gap:8px;height:44px;padding:0 16px;border:none;border-radius:8px;background:#010930;color:#fff;font-family:inherit;font-size:15px;font-weight:600;cursor:pointer;white-space:nowrap"><span data-icon-slot><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg></span></span><span data-label>Copy link</span></button>
            {shares.map((s) => (<>
              <a href={s.href} target="_blank" rel="noopener noreferrer" style="display:flex;align-items:center;height:44px;padding:0 16px;border-radius:8px;border:1px solid rgba(1,9,48,0.2);color:#010930;font-size:15px;font-weight:500;white-space:nowrap" class="hcto3j">{s.label}</a>
            </>))}
          </div>
        </div>
      </div>
    </section>

    <section data-tide="1" id="download" aria-labelledby="h-download" style="position:relative;background:#010930;color:#f2f5ff;padding:150px clamp(20px,4vw,48px) 0">
      <div style="position:relative;z-index:2;max-width:1180px;margin:0 auto;display:flex;flex-direction:column;align-items:center;text-align:center;gap:24px">
        <a href={links.installer} aria-label="Download DriftFetch for Windows" style="width:104px;height:104px;border-radius:50%;background:#0b67fe;color:#fff;display:flex;align-items:center;justify-content:center" class="h1ifpqlp"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 17V3" />
  <path d="m6 11 6 6 6-6" />
  <path d="M19 21H5" /></svg></span></a>
        <h2 id="h-download" style="margin:12px 0 0;font-size:clamp(44px,7vw,96px);line-height:0.95;font-weight:800;letter-spacing:-0.05em">Let it drift in.</h2>
        <p style="margin:0;color:#c7cfea;max-width:28em;text-wrap:pretty">An installer or a portable zip. It starts in the tray and is ready the moment you copy your first link.</p>
        <a href={links.installer} style="display:flex;align-items:center;gap:10px;height:56px;padding:0 26px 0 22px;margin-top:6px;border-radius:10px;background:#fff;color:#010930;font-size:17px;font-weight:700" class="hnuvhf7"><span class="ic"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 17V3" />
  <path d="m6 11 6 6 6-6" />
  <path d="M19 21H5" /></svg></span>Download for Windows</a>
        <ul style="list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;justify-content:center;gap:6px 26px;font-size:14.5px;color:#8a96bd">
          <li>Windows 10 or 11, 64-bit</li><li>Version {site.version}</li><li>MIT licence</li><li><a href={links.releaseNotes} style="color:#c7cfea" class="hxpj8jr">Release notes</a></li><li><a href={links.releases} style="color:#c7cfea" class="hxpj8jr">All releases</a></li>
        </ul>
      </div>

      
    </section>
  
<style>
  .hero-art { position:absolute; right:0; top:0; width:min(440px, 38%); height:470px; pointer-events:none; --cyc:12s; }
  .ha-wave { position:absolute; left:-30%; top:210px; width:160%; height:120px; opacity:.55; filter:drop-shadow(0 0 8px #0cf3fe); animation:ha-drift 9s ease-in-out infinite alternate; }
  .ha-pill { position:absolute; left:0; top:14px; display:flex; align-items:center; gap:10px; max-width:100%; padding:11px 16px; border-radius:999px; background:rgba(11,40,120,.55); box-shadow:0 0 0 1px rgba(12,243,254,.45), 0 0 26px rgba(11,103,254,.45); color:#e8f6ff; font:500 clamp(12px,1.05vw,14.5px)/1 'JetBrains Mono',ui-monospace,monospace; white-space:nowrap; animation:ha-pill var(--cyc) infinite; }
  .ha-pill svg { color:#0cf3fe; flex:none; }
  .ha-arrow { position:absolute; right:6%; top:62px; animation:ha-fade var(--cyc) infinite; }
  .ha-arrow path { stroke-dasharray:1; animation:ha-draw var(--cyc) infinite; }
  .ha-card { position:absolute; width:56%; aspect-ratio:4/3; border-radius:12px; overflow:hidden; background:#0b1a4d; box-shadow:0 0 0 1px rgba(255,255,255,.14), 0 18px 40px -10px rgba(0,0,0,.6), 0 0 30px rgba(11,103,254,.35); opacity:0; }
  .ha-card img { display:block; width:100%; height:100%; object-fit:cover; }
  .ha-a { left:2%; top:170px; --r:-7deg; z-index:1; animation:ha-in-a var(--cyc) infinite; }
  .ha-b { left:38%; top:150px; --r:6deg; z-index:2; animation:ha-in-b var(--cyc) infinite; }
  .ha-c { left:18%; top:262px; --r:-2deg; z-index:3; animation:ha-in-c var(--cyc) infinite; }
  .ha-bar { position:absolute; left:10px; right:10px; bottom:10px; height:6px; border-radius:3px; background:rgba(1,9,48,.7); overflow:hidden; }
  .ha-bar i { display:block; height:100%; width:100%; background:linear-gradient(90deg,#0b67fe,#0cf3fe); transform-origin:left; animation:ha-fill var(--cyc) infinite; }
  .ha-saved { position:absolute; right:10px; top:10px; display:flex; align-items:center; gap:5px; padding:4px 9px; border-radius:999px; background:#1d7a4c; color:#fff; font:600 12px/1 'Schibsted Grotesk Variable',sans-serif; opacity:0; animation:ha-saved var(--cyc) infinite; }
  @keyframes ha-drift { from { transform:translateX(-4%); } to { transform:translateX(4%); } }
  @keyframes ha-pill { 0%{opacity:0;transform:translateY(-14px)} 6%,84%{opacity:1;transform:none} 12%{box-shadow:0 0 0 1px #0cf3fe,0 0 44px #0cf3fe} 18%{box-shadow:0 0 0 1px rgba(12,243,254,.45),0 0 26px rgba(11,103,254,.45)} 94%,100%{opacity:0;transform:none} }
  @keyframes ha-draw { 0%,16%{stroke-dashoffset:1} 26%,84%{stroke-dashoffset:0} 94%,100%{stroke-dashoffset:0} }
  @keyframes ha-fade { 0%,15%{opacity:0} 20%,84%{opacity:1} 94%,100%{opacity:0} }
  @keyframes ha-in-a { 0%,26%{opacity:0;transform:translateY(24px) rotate(var(--r))} 34%,84%{opacity:1;transform:rotate(var(--r))} 94%,100%{opacity:0;transform:rotate(var(--r))} }
  @keyframes ha-in-b { 0%,30%{opacity:0;transform:translateY(24px) rotate(var(--r))} 38%,84%{opacity:1;transform:rotate(var(--r))} 94%,100%{opacity:0;transform:rotate(var(--r))} }
  @keyframes ha-in-c { 0%,34%{opacity:0;transform:translateY(24px) rotate(var(--r))} 42%,84%{opacity:1;transform:rotate(var(--r))} 94%,100%{opacity:0;transform:rotate(var(--r))} }
  @keyframes ha-fill { 0%,42%{transform:scaleX(0)} 62%,100%{transform:scaleX(1)} }
  @keyframes ha-saved { 0%,63%{opacity:0;transform:scale(.8)} 68%,84%{opacity:1;transform:none} 94%,100%{opacity:0} }
  /* Reduced motion: hold the finished frame, nothing moves. */
  @media (prefers-reduced-motion: reduce) {
    .hero-art *, .hero-art { animation:none !important; }
    .ha-card { opacity:1; transform:rotate(var(--r)); }
    .ha-saved { opacity:1; }
  }
</style>
<script>import "../scripts/home";</script>
</Layout>
