---
import { u } from "../data/site";
import { Icon } from "./icon";
const { current } = Astro.props;
const nav = [["Sites", "/sites"], ["Extensions", "/extensions"], ["FAQ", "/faq"], ["About", "/about"], ["Donate", "/donate"]];
---
<header style="position:relative;z-index:30;padding:0 clamp(20px,4vw,48px);background:#010930">
  <div class="hd" style="max-width:1180px;margin:0 auto;border-bottom:1px solid rgba(255,255,255,0.1)">
    <a href={u("/")} class="hd-logo" aria-label="DriftFetch home" style="display:flex;align-items:center;gap:10px;color:#fff"><img src={u("/driftfetch-icon.png")} alt="" width="28" height="28" style="width:28px;height:28px;border-radius:7px;display:block"><span style="font-size:18px;font-weight:700;letter-spacing:-0.02em">DriftFetch</span></a>
    <nav aria-label="Main" class="hd-nav" style="font-size:15px;font-weight:500">
      {nav.map(([label, href]) => <a href={u(href)} class="nav-link" aria-current={current === href ? "page" : undefined} style={`color:${current === href ? "#fff" : "#b7c1e0"}`}>{label}</a>)}
    </nav>
    <a href={u("/download")} class="nav-dl" aria-current={current === "/download" ? "page" : undefined} style="display:flex;align-items:center;gap:8px;height:40px;padding:0 14px;border-radius:8px;background:#0b67fe;color:#fff;font-weight:600;font-size:15px"><Fragment set:html={Icon("arrow-down-to-line", 16, 2)} />Download</a>
  </div>
</header>
<style>
  .hd { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0 16px; padding: 10px 0 2px; }
  .hd-logo { grid-column: 1; grid-row: 1; }
  .nav-dl { grid-column: 2; grid-row: 1; }
  .hd-nav { grid-column: 1 / -1; grid-row: 2; display: flex; justify-content: space-between; }
  .nav-link { display: inline-flex; align-items: center; min-height: 44px; }
  @media (min-width: 860px) {
    .hd { display: flex; min-height: 76px; padding: 0; gap: 22px; }
    .hd-logo { margin-right: auto; }
    .hd-nav { gap: 22px; }
    .nav-link { min-height: 0; }
  }
  .nav-link:hover { color: #fff !important; }
  .nav-dl:hover { background: #2a7bff !important; color: #fff !important; }
</style>
