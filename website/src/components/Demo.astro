---
import { u } from "../data/site";
import { Icon, iconInner } from "./icon";
const clientIcons = Object.fromEntries(["loader-circle","circle-alert","list-checks","copy","arrow-down-to-line","check","film","link"].map((n) => [n, iconInner(n)]));
---
<div role="region" aria-label="DriftFetch demo" style="position:relative;border-radius:12px;background:#0b0e17;overflow:hidden;box-shadow:0 0 0 1px rgba(1,9,48,0.25),0 30px 70px rgba(1,9,48,0.4);font-family:'Segoe UI Variable Text','Segoe UI',system-ui,sans-serif;font-size:13px;line-height:20px;color:#e9ecf4">
          <div style="height:36px;display:flex;align-items:center;background:#090c14;border-bottom:1px solid #1a1f2c">
            <div style="display:flex;align-items:center;gap:8px;padding:0 12px;flex:1;min-width:0"><img src={u("/driftfetch-icon.png")} alt="" style="width:16px;height:16px;border-radius:4px;display:block"><span style="font-size:12px;font-weight:600;color:#c9cfdc">DriftFetch</span></div>
            <span style="width:40px;display:flex;justify-content:center;color:#7f879a"><Fragment set:html={Icon("minus", 13, 1.5)} /></span>
            <span style="width:40px;display:flex;justify-content:center;color:#7f879a"><Fragment set:html={Icon("square", 10, 1.5)} /></span>
            <span style="width:40px;display:flex;justify-content:center;color:#7f879a"><Fragment set:html={Icon("x", 14, 1.5)} /></span>
          </div>
          <div style="padding:16px 16px 0;display:flex;flex-direction:column;gap:12px">
            <div style="display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:10px;background:rgba(11,103,254,0.1);border:1px solid rgba(106,166,255,0.18)">
              <span style="width:30px;height:30px;flex:none;border-radius:8px;background:rgba(12,243,254,0.08);color:#5fe3ee;display:flex;align-items:center;justify-content:center"><Fragment set:html={Icon("radio", 16, 1.75)} /></span>
              <div style="flex:1;min-width:0"><div style="font-weight:600">Listening for links</div><div style="font-size:12px;color:#a6adbe;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><span id="demo-sub">Copy a video or gallery link and it appears here.</span></div></div>
              <span style="width:32px;height:18px;border-radius:9px;background:#0b67fe;position:relative;flex:none"><span style="position:absolute;top:2px;left:16px;width:14px;height:14px;border-radius:50%;background:#fff"></span></span>
            </div>
            <div style="border-radius:10px;border:1px solid #1a1f2c;background:#0e121b;overflow:hidden;height:268px;display:flex;flex-direction:column">
              <div style="display:flex;align-items:center;height:34px;flex:none;padding:0 14px;border-bottom:1px solid #1a1f2c;background:#0c1019;font-size:10.5px;font-weight:600;letter-spacing:0.08em;color:#7f879a"><span style="flex:1">VIDEO / SOURCE</span><span style="width:150px">STATUS</span></div>
              <div id="demo-empty" style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:24px;text-align:center;color:#a6adbe">
                  <span style="color:#6aa6ff;display:flex"><Fragment set:html={Icon("clipboard-paste", 22, 1.75)} /></span>
                  <span style="font-weight:600;color:#e9ecf4">Nothing here yet</span>
                  <span style="font-size:12.5px;max-width:260px"><span class="only-wide">Copy a link on the left and watch it land.</span><span class="only-narrow">Copy a link above and watch it land.</span></span>
                </div>
              
              <div id="demo-rows" style="display:contents"></div>
            </div>
          </div>
          <div style="display:flex;align-items:center;gap:8px;padding:12px 16px;font-size:12px;color:#7f879a">
            <span id="demo-count">0 items</span><span style="flex:1"></span>
            <button id="demo-clear" hidden style="border:none;background:transparent;color:#6aa6ff;font-family:inherit;font-size:12px;cursor:pointer;padding:0">Clear</button>
          </div>
          <div id="demo-toast" hidden role="status" style="position:absolute;left:50%;bottom:52px;transform:translateX(-50%);display:flex;align-items:center;gap:10px;height:40px;padding:0 14px;border-radius:8px;background:#1a2030;border:1px solid #2a3142;box-shadow:0 6px 16px rgba(0,0,0,0.35);font-size:12.5px;white-space:nowrap">
              <span style="color:#5fe3ee;display:flex"><Fragment set:html={Icon("clipboard-check", 15, 1.75)} /></span><span id="demo-toast-text"></span>
            </div>
        </div>
<script type="application/json" id="demo-icons" set:html={JSON.stringify(clientIcons)} />
