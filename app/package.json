{
  "name": "driftfetch",
  "productName": "DriftFetch",
  "version": "0.2.1",
  "description": "A quiet, capable desktop download manager",
  "author": "DriftFetch contributors",
  "private": true,
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:sources": "node scripts/source-check.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "engines": "node scripts/prepare-engines.mjs",
    "engines:bump": "node scripts/prepare-engines.mjs --bump",
    "sources": "node scripts/fetch-sources.mjs",
    "ffmpeg:build": "node scripts/build-ffmpeg.mjs",
    "privacy": "node scripts/make-privacy-notice.mjs",
    "release:check": "node scripts/release-check.mjs",
    "package": "npm run engines && npm run release:check && npm run build && electron-builder --win nsis --x64",
    "package:dir": "npm run engines && npm run build && electron-builder --win --dir --x64",
    "package:portable": "npm run engines && npm run release:check && npm run build && electron-builder --win portable --x64",
    "test:installed-engines": "node scripts/installed-engines-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "openpgp": "^6.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "afterAllArtifactBuild": "scripts/checksums.cjs",
    "appId": "local.driftfetch.app",
    "productName": "DriftFetch",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "THIRD-PARTY-NOTICES.md"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "licenses",
        "filter": ["LICENSE", "THIRD-PARTY-NOTICES.md", "SOURCE-OFFER.md"]
      },
      {
        "from": "electron/extension-host.cjs",
        "to": "extension-host.cjs"
      },
      {
        "from": "resources/engines",
        "to": "engines"
      },
      {
        "from": "resources/yt-dlp-plugins",
        "to": "yt-dlp-plugins"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": false,
      "include": "build/installer.nsh",
      "license": "build/privacy-notice.txt"
    },
    "artifactName": "DriftFetch-Setup-${version}-${arch}.${ext}",
    "portable": {
      "artifactName": "DriftFetch-Portable-${version}-${arch}.${ext}"
    }
  }
}
